--- /dev/null	2026-10-25 00:01:53.000000000 +0530
+++ b/ggml/src/ggml-cuda/mmvq-bi.cuh	2026-10-25 00:01:53.223795500 +0530
@@ -0,0 +1,223 @@
+#pragma once
+
+// Batch-invariant multi-column mat-vec for Q4_K and Q6_K (hiraishin).
+//
+// Speculative verification runs the target on 2-9 tokens at once and must reproduce, bit for bit, the logits
+// of decoding each token alone. The one-column mul_mat_vec_q kernel fixes the arithmetic: thread -> K-block
+// mapping (nwarps = 4 on the GENERIC table), the per-thread accumulation order over K, and the reduction
+// (shared memory over warps in order, then warp_reduce_sum). This kernel keeps all of that per column and
+// calls the same vec_dot_*_impl functions on the same values, so each column's fp32 sum is computed in the
+// same order. What it shares across columns is only integer work: the weight loads and the Q4_K scale
+// unpacking are done once per (row, K-block) instead of once per (row, K-block, column), and each column's
+// activation block is loaded once per thread and reused across the rows of the CUDA block.
+
+#include "common.cuh"
+#include "vecdotq.cuh"
+
+#define MMVQ_BI_NWARPS 4  // calc_nwarps(type, 1, MMVQ_PARAMETERS_GENERIC) for Q4_K and Q6_K
+#define MMVQ_BI_KQ_MAX_COLS 12  // this kernel handles 2..12 columns in one launch (no chunking)
+
+struct mmvq_bi_x_q4_K {
+    int      v[2];
+    uint16_t aux[2];
+    half2    dm;
+};
+
+struct mmvq_bi_x_q6_K {
+    int    vl;
+    int    vh;
+    int8_t sc[5];  // impl reads scales[0] and scales[4]
+    float  d;
+};
+
+// weight side of vec_dot_q4_K_q8_1, unchanged
+static __device__ __forceinline__ void mmvq_bi_load_x(const void * __restrict__ vbq, const int kbx, const int iqs, mmvq_bi_x_q4_K & x) {
+    const block_q4_K * bq4_K = (const block_q4_K *) vbq + kbx;
+    const int bq8_offset = QR4_K * ((iqs/2) / (QI8_1/2));
+    const int * q4 = (const int *)(bq4_K->qs + 16 * bq8_offset + 4 * ((iqs/2)%4));
+    x.v[0] = q4[0];
+    x.v[1] = q4[4];
+    const uint16_t * scales = (const uint16_t *)bq4_K->scales;
+    const int j = bq8_offset/2;
+    if (j < 2) {
+        x.aux[0] = scales[j+0] & 0x3f3f;
+        x.aux[1] = scales[j+2] & 0x3f3f;
+    } else {
+        x.aux[0] = ((scales[j+2] >> 0) & 0x0f0f) | ((scales[j-2] & 0xc0c0) >> 2);
+        x.aux[1] = ((scales[j+2] >> 4) & 0x0f0f) | ((scales[j-0] & 0xc0c0) >> 2);
+    }
+    x.dm = bq4_K->dm;
+}
+
+// activation side of vec_dot_q4_K_q8_1 plus the same impl call
+static __device__ __forceinline__ float mmvq_bi_dot(const mmvq_bi_x_q4_K & x, const block_q8_1 * __restrict__ bq8_1, const int iqs) {
+    int   u[2*QR4_K];
+    float d8[QR4_K];
+    const int bq8_offset = QR4_K * ((iqs/2) / (QI8_1/2));
+    const uint8_t * sc = (const uint8_t *) x.aux;
+    const uint8_t * m  = sc + 2;
+    for (int i = 0; i < QR4_K; ++i) {
+        const block_q8_1 * bq8i = bq8_1 + bq8_offset + i;
+        d8[i] = __low2float(bq8i->ds);
+        const int * q8 = (const int *)bq8i->qs + ((iqs/2)%4);
+        u[2*i+0] = q8[0];
+        u[2*i+1] = q8[4];
+    }
+    return vec_dot_q4_K_q8_1_impl_vmmq(x.v, u, sc, m, x.dm, d8);
+}
+
+// weight side of vec_dot_q6_K_q8_1, unchanged
+static __device__ __forceinline__ void mmvq_bi_load_x(const void * __restrict__ vbq, const int kbx, const int iqs, mmvq_bi_x_q6_K & x) {
+    const block_q6_K * bq6_K = (const block_q6_K *) vbq + kbx;
+    const int scale_offset = (QI6_K/4) * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/8);
+    const int vh_shift = 2 * ((iqs % (QI6_K/2)) / (QI6_K/4));
+    x.vl = get_int_b2(bq6_K->ql, iqs);
+    x.vh = get_int_b2(bq6_K->qh, (QI6_K/4) * (iqs / (QI6_K/2)) + iqs % (QI6_K/4)) >> vh_shift;
+    const int8_t * scales = bq6_K->scales + scale_offset;
+    x.sc[0] = scales[0];
+    x.sc[4] = scales[4];
+    x.d = bq6_K->d;
+}
+
+// activation side of vec_dot_q6_K_q8_1 plus the same impl call
+static __device__ __forceinline__ float mmvq_bi_dot(const mmvq_bi_x_q6_K & x, const block_q8_1 * __restrict__ bq8_1, const int iqs) {
+    const int bq8_offset = 2 * QR6_K * (iqs / (QI6_K/2)) + (iqs % (QI6_K/2)) / (QI6_K/4);
+    int   u[QR6_K];
+    float d8[QR6_K];
+#pragma unroll
+    for (int i = 0; i < QR6_K; ++i) {
+        u[i]  = get_int_b4(bq8_1[bq8_offset + 2*i].qs, iqs % QI8_1);
+        d8[i] = __low2float(bq8_1[bq8_offset + 2*i].ds);
+    }
+    return vec_dot_q6_K_q8_1_impl_mmvq(x.vl, x.vh, u, x.sc, x.d, d8);
+}
+
+template <ggml_type type> struct mmvq_bi_traits;
+template <> struct mmvq_bi_traits<GGML_TYPE_Q4_K> { using x_t = mmvq_bi_x_q4_K; static constexpr int vdr = VDR_Q4_K_Q8_1_MMVQ; };
+template <> struct mmvq_bi_traits<GGML_TYPE_Q6_K> { using x_t = mmvq_bi_x_q6_K; static constexpr int vdr = VDR_Q6_K_Q8_1_MMVQ; };
+
+template <ggml_type type, int ncols_dst, int rows_per_block>
+__launch_bounds__(MMVQ_BI_NWARPS*WARP_SIZE, 1)
+static __global__ void mul_mat_vec_q_bi(
+        const void * __restrict__ vx, const void * __restrict__ vy, float * __restrict__ dst,
+        const uint32_t ncols_x, const uint32_t nrows_x, const uint32_t stride_row_x, const uint32_t stride_col_y,
+        const uint32_t stride_col_dst) {
+    using x_t = typename mmvq_bi_traits<type>::x_t;
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = mmvq_bi_traits<type>::vdr;
+    constexpr int nwarps = MMVQ_BI_NWARPS;
+    constexpr int warp_size = WARP_SIZE;
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    const int tid  = warp_size*threadIdx.y + threadIdx.x;
+    const int row0 = rows_per_block*blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+
+    ggml_cuda_pdl_sync();
+
+    float tmp[ncols_dst][rows_per_block] = {{0.0f}};
+    const block_q8_1 * y = (const block_q8_1 *) vy;
+    const int kbx_offset = row0*stride_row_x;
+
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+
+        x_t xs[rows_per_block];
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            mmvq_bi_load_x(vx, kbx_offset + i*stride_row_x + kbx, kqs, xs[i]);
+        }
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp[j][i] += mmvq_bi_dot(xs[i], &y[j*stride_col_y + kby], kqs);
+            }
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1][ncols_dst][rows_per_block][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_block; ++i) {
+                tmp_shared[threadIdx.y-1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+    dst += row0;
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps-1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<warp_size>(tmp[j][i]);
+            if (threadIdx.x == i) {
+                dst[j*stride_col_dst + i] = tmp[j][i];
+            }
+        }
+    }
+}
+
+// rows per CUDA block for the BI kernel; HIRAISHIN_BI_ROWS=1|2|4|8 overrides (for tuning).
+// The kernel has no row bounds checks, so the caller only uses it when nrows_x is a multiple of 8.
+static inline int mmvq_bi_rows_per_block() {
+    static const int r = [] {
+        const char * s = getenv("HIRAISHIN_BI_ROWS");
+        const int v = s ? atoi(s) : 4;
+        return (v == 1 || v == 2 || v == 4 || v == 8) ? v : 4;
+    }();
+    return r;
+}
+
+template <ggml_type type, int ncols_dst>
+static void mul_mat_vec_q_bi_launch_rows(
+        const void * vx, const void * vy, float * dst, const int ncols_x, const int nrows_x,
+        const int stride_row_x, const int stride_col_y, const int stride_col_dst, cudaStream_t stream) {
+    const dim3 block_dims(WARP_SIZE, MMVQ_BI_NWARPS, 1);
+    const auto go = [&](auto rows_tag) {
+        constexpr int R = decltype(rows_tag)::value;
+        const dim3 block_nums((nrows_x + R - 1) / R, 1, 1);
+        const ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(block_nums, block_dims, 0, stream);
+        ggml_cuda_kernel_launch(mul_mat_vec_q_bi<type, ncols_dst, R>, launch_params,
+            vx, vy, dst, (uint32_t) ncols_x, (uint32_t) nrows_x, (uint32_t) stride_row_x, (uint32_t) stride_col_y,
+            (uint32_t) stride_col_dst);
+    };
+    switch (mmvq_bi_rows_per_block()) {
+        case 1:  go(std::integral_constant<int, 1>{}); break;
+        case 2:  go(std::integral_constant<int, 2>{}); break;
+        case 8:  go(std::integral_constant<int, 8>{}); break;
+        default: go(std::integral_constant<int, 4>{}); break;
+    }
+}
+
+template <ggml_type type>
+static void mul_mat_vec_q_bi_switch(
+        const void * vx, const void * vy, float * dst, const int ncols_x, const int nrows_x, const int ncols_dst,
+        const int stride_row_x, const int stride_col_y, const int stride_col_dst, cudaStream_t stream) {
+    switch (ncols_dst) {
+        case 2: mul_mat_vec_q_bi_launch_rows<type, 2>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 3: mul_mat_vec_q_bi_launch_rows<type, 3>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 4: mul_mat_vec_q_bi_launch_rows<type, 4>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 5: mul_mat_vec_q_bi_launch_rows<type, 5>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 6: mul_mat_vec_q_bi_launch_rows<type, 6>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 7: mul_mat_vec_q_bi_launch_rows<type, 7>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 8: mul_mat_vec_q_bi_launch_rows<type, 8>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 9: mul_mat_vec_q_bi_launch_rows<type, 9>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 10: mul_mat_vec_q_bi_launch_rows<type, 10>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 11: mul_mat_vec_q_bi_launch_rows<type, 11>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        case 12: mul_mat_vec_q_bi_launch_rows<type, 12>(vx, vy, dst, ncols_x, nrows_x, stride_row_x, stride_col_y, stride_col_dst, stream); break;
+        default: GGML_ABORT("mul_mat_vec_q_bi: unsupported ncols_dst %d", ncols_dst);
+    }
+}
